ANONIMIZADOR_TITLE=Anonimizador
ANONIMIZADOR_PORT=7999

PYTHON_COMMAND=/usr/bin/python3

SUMARIZADOR_PORT=7997
DESCRITORES_PORT=7998

ANONIMIZADOR_SECRET=secret101

# Max characters the NLP transformer processes in a single pass; larger texts
# (big decisions) are split into chunks of this size. Bigger = faster/fewer
# chunks but more peak RAM per request. Too big OOM-kills the nlp_server
# container (shows up as "socket hang up"/ECONNRESET on the anonimizador).
# Recommended values by RAM available to the nlp_server container:
#   16 GB ->  50000   (safe default)
#   24 GB -> 100000
#   32 GB -> 150000
#   64 GB -> 300000
# These are conservative; raise them only if you watch `docker stats` and see
# headroom during a big-decision run.
NLP_CHUNK_CHARS=50000
